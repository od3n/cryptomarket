# Application
APP_ENV=development
SERVICE_NAME=market-api
HTTP_PORT=8080
LOG_LEVEL=info

# PostgreSQL
POSTGRES_DSN=postgres://cryptouser:cryptopass@localhost:5432/cryptomarket?sslmode=disable

# Redis
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Ingestion
INGESTION_INTERVAL=60s
PROVIDER_BASE_URL=https://api.coingecko.com/api/v3
PROVIDER_TIMEOUT=10s
