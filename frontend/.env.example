# Frontend Environment Configuration
# Copy this file to .env.local and adjust values

# API base URL (used by server-side rewrites)
API_URL=http://localhost:8080

# Realtime gateway URL (used by server-side rewrites)
REALTIME_URL=http://localhost:8081

# Data freshness thresholds (in seconds)
NEXT_PUBLIC_FRESH_THRESHOLD=120
NEXT_PUBLIC_STALE_THRESHOLD=300

# Public app environment
NEXT_PUBLIC_APP_ENV=development

# Analytics (disabled by default)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
